# kytelink environment
#
# we recommend you run `pnpm run setup` to fill this in.
#
# only the required section is needed to boot. everything else is optional and
# turns itself off when left blank. see SELF-HOSTING.md

# which docker services to start. optional if you run postgres and redis yourself.
COMPOSE_PROFILES=core,analytics,uploads,email

# --- required ---

# postgres, the main database.
DATABASE_URL=postgresql://kyte:kyte@localhost:5432/kyte

# redis. caches, rate limits, queues.
REDIS_URL=redis://localhost:6379

# secrets for auth sessions and internal api calls. generate each one with
# openssl rand -hex 32
AUTH_SECRET=dev-only-change-me-00000000000000000000000000000000
INTERNAL_API_SECRET=dev-only-change-me-00000000000000000000000000000000

# public url of each app.
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3003
LANDING_ZONE_URL=http://localhost:3001

# --- recommended ---

# unpooled postgres, used only to run migrations. the same as DATABASE_URL
# unless your host puts a pooler in front of it.
DIRECT_URL=postgresql://kyte:kyte@localhost:5432/kyte

# public url of the admin app. also its cors allowlist entry, so admin api
# calls are blocked in production if you leave it unset.
ADMIN_BASE_URL=http://localhost:3002

# emails granted platform admin on first login, comma separated. without one
# nobody can reach the admin app on a fresh install.
ADMIN_EMAILS=

# --- optional ---

# analytics. without this, beacons are dropped and the analytics pages show a
# setup card instead of data.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_PASSWORD=kyte

# uploads. any s3 api works, so r2, minio and s3 are all fine. region can stay
# auto outside of aws. without this there are no image uploads, avatars fall
# back to generated initials and og cards are text only.
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=auto
AWS_S3_BUCKET=kytelink-assets

# urls the browser is allowed to see. never put a secret in a NEXT_PUBLIC_ var.
# the cdn one points at your bucket and falls back to https://cdn.kytelink.com.
# the other three mirror the server urls above so client code can reach them.
NEXT_PUBLIC_CDN_URL=http://localhost:9000/kytelink-assets
NEXT_PUBLIC_API_URL=http://localhost:3003
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_LANDING_URL=http://localhost:3001

# oauth. without a pair, that provider's button is hidden. email codes always work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# email. the provider can be console, smtp or resend. smtp is the default
# because docker already runs mailpit on the host and port below. console only
# prints login codes to the server logs and mailpit will not show them.
EMAIL_PROVIDER=smtp
EMAIL_FROM="Kytelink <auth@mail.kytelink.com>"
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# moderation and ai link import. the provider can be none or openai. any
# openai compatible api works if you set a base url. without a key, publishes
# are auto approved and ai import is hidden. linktree and bio.link still import.
MODERATION_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODERATION_MODEL=gpt-4o-mini

# custom domains. proxy is for self hosting, where your reverse proxy issues
# certificates on demand and dns is what verifies a domain. vercel registers
# the domain on your vercel project, which dns alone cannot do. the a record is
# your edge ip and the cname is a hostname pointing at your edge. the vercel
# keys are only read in vercel mode. without any of this the domain page says
# it is unconfigured.
DOMAIN_PROVIDER=proxy
CUSTOM_DOMAIN_A_RECORD=
CUSTOM_DOMAIN_CNAME_TARGET=
VERCEL_TOKEN=
VERCEL_TEAM=
VERCEL_PROJECT=

# self hosted edge, read by deploy/Caddyfile. the email gets certificate expiry
# notices and the hostnames get certificates at boot. your users' custom
# domains are issued on demand and do not belong here.
ACME_EMAIL=
WEB_HOSTNAME=
LANDING_HOSTNAME=
ADMIN_HOSTNAME=
API_HOSTNAME=

# --- local dev only ---

# apps/api refuses to boot with either of these when NODE_ENV=production.
# agent mode seeds two dev accounts, accepts the code 000000 for any
# @kytelink.dev address and moves every app to port+1000 under `pnpm agents`.
# mock providers let you test oauth without real google or github apps.
AGENT_MODE=false
AUTH_MOCK_PROVIDERS=false
