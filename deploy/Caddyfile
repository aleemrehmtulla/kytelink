# Kytelink self-hosting edge — terminates TLS for your own hostnames AND for
# every custom domain your users point at this instance.
#
# The `ask` endpoint is what makes arbitrary customer domains safe: before Caddy
# issues a certificate for a hostname it has never seen, it asks the API whether
# that domain is a verified custom domain. Without it, anyone could aim a DNS
# record at this server and burn through Let's Encrypt's rate limits.
#
# See SELF-HOSTING.md § Custom domains for the full walkthrough.

{
	email {$ACME_EMAIL}

	on_demand_tls {
		ask http://api:3003/internal/domains/allowed
		interval 2m
		burst 5
	}
}

# Your own hostnames. Certificates for these are issued up front at boot, not on
# demand, so a misconfigured `ask` can never take the main site down.
{$WEB_HOSTNAME} {
	reverse_proxy web:3000
}

{$LANDING_HOSTNAME} {
	reverse_proxy landing:3001
}

{$ADMIN_HOSTNAME} {
	reverse_proxy admin:3002
}

{$API_HOSTNAME} {
	reverse_proxy api:3003
}

# Everything else: a user's custom domain. Certificates are issued on first
# request, gated by `ask` above, and the request is served by the web app, whose
# middleware resolves the host to its profile.
https:// {
	tls {
		on_demand
	}
	reverse_proxy web:3000
}
