{
  "name": "kytelink",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:deploy": "node scripts/db.mjs deploy",
    "db:status": "node scripts/db.mjs status",
    "db:deploy:prod": "node scripts/db.mjs deploy --prod",
    "db:status:prod": "node scripts/db.mjs status --prod",
    "migrate:prod": "node scripts/migrate-prod.mjs",
    "dev": "node scripts/dev.mjs",
    "agents": "node scripts/agents.mjs",
    "mock-api": "pnpm --filter @kytelink/api mock-api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@kytelink/config": "workspace:*",
    "dotenv": "^17.4.2",
    "prettier": "^3.9.5",
    "turbo": "^2.10.5",
    "typescript": "6.0.3"
  },
  "prettier": "@kytelink/config/prettier"
}
